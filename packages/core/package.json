{
  "name": "@torii-gate/core",
  "version": "1.0.0",
  "description": "RFC 9700-compliant OAuth 2.0 Token Handler core engine with PKCE, OAuth Agent, and OAuth Proxy for edge-native BFF architectures",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "types:check": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf lib"
  },
  "author": "Chathuranga Hengodage",
  "license": "EUPL-1.2",
  "packageManager": "pnpm@10.30.3",
  "keywords": [
    "hono",
    "bff",
    "oauth2",
    "oidc",
    "pkce",
    "rfc9700",
    "edge",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/toriijs/torii-gate",
    "directory": "packages/core"
  },
  "dependencies": {
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0"
  }
}
